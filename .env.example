# Centinela — variables de entorno de referencia.
#
# TODAS son opcionales: el sistema arranca sin ninguna y los valores por defecto son los que
# aparecen aqui. Se documentan en `docs/operacion.md` y se publican en `GET /api/salud`.
#
# Copiar a `.env` y ajustar lo que haga falta. `.env` NO se versiona.
#
# Este archivo no contiene ningun secreto: los dos campos sensibles --el token de acceso y el
# secreto del webhook-- van vacios a proposito, porque su valor lo elige quien despliega. El
# sistema no necesita ninguna clave de API: el modelo de lenguaje, la transcripcion, la
# sintesis de voz y la base vectorial corren en local.

# ---------------------------------------------------------------- modelo de lenguaje
# Ollama en local. El modelo declarado para la compuerta G3 va fijo en el codigo; esto solo
# dice donde escuchar.
CENTINELA_OLLAMA_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------- transcripcion (STT)
# faster-whisper. Vacio = se elige solo segun la maquina (CUDA si hay, CPU si no).
CENTINELA_STT_MODEL=
CENTINELA_STT_DEVICE=
CENTINELA_STT_COMPUTE=

# ---------------------------------------------------------------- voz (TTS)
# La voz del agente es una clonacion pre-renderizada que se lee de `data/audio_clon/`.
# A 0 habla enteramente Piper: es el interruptor para descartar la voz clonada sin borrar nada.
CENTINELA_VOZ_CLONADA=1
# Pre-renderizar el guion al arrancar. A 0 se sintetiza en el turno, y se nota.
CENTINELA_PRERENDER=1
CENTINELA_WARMUP=1

# ---------------------------------------------------------------- conversacion
# El paciente puede cortarle la palabra al agente. A 0 la voz sale entera.
CENTINELA_BARGEIN=1
CENTINELA_BARGEIN_MARGEN_ECO=1.8
CENTINELA_BARGEIN_MS_CONF=250
# El turno cierra en cuanto la respuesta se sostiene sola. A 0, siempre el techo.
CENTINELA_CIERRE_ADAPTATIVO=1
CENTINELA_CIERRE_MIN_MS=450
# La escalera de silencio cuando el paciente no contesta.
CENTINELA_SILENCIO=1
# Cuanto se espera a que el navegador vuelva antes de dar la llamada por colgada.
CENTINELA_GRACIA_RECONEXION_S=20
CENTINELA_TIMEOUT_LLAMADA_S=180

# ---------------------------------------------------------------- escalamiento
CENTINELA_SLA_ROJO_MIN=15
CENTINELA_SLA_AMARILLO_H=24
# URL a la que se entregan las alertas, ademas del disco. Vacio = solo disco.
CENTINELA_WEBHOOK_ALERTAS=
# Secreto para la firma HMAC-SHA256 del cuerpo del webhook. Ponerlo aqui NUNCA: va en `.env`.
CENTINELA_SECRETO_WEBHOOK=

# ---------------------------------------------------------------- acceso
# Si se define, protege los endpoints que modifican algo y la llamada entera, canal de voz
# incluido. Una sola palabra (ver `docs/operacion.md`). Vacio = sin proteccion, que es lo
# adecuado para una demo local y NO para un despliegue real.
CENTINELA_TOKEN=

# ---------------------------------------------------------------- limites
CENTINELA_MAX_MB_DOC=64
